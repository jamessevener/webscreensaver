#!/bin/sh
# Switch a Raspberry Pi OS (labwc) kiosk between the kiosk-only session and
# the normal desktop. Takes effect at the next login/reboot.
#
#   kiosk-mode on      kiosk only (no desktop, panel or XDG autostart)
#   kiosk-mode off     normal desktop; the kiosk is not started
#   kiosk-mode status
#
# Pi OS starts labwc with -m, which runs /etc/xdg/labwc/autostart as well as
# ~/.config/labwc/autostart, so the desktop and panel are turned off there.
# The kiosk itself is a block in the user autostart written by setup-kiosk;
# "off" moves that block aside to autostart.kiosk, leaving other entries.

SYS=/etc/xdg/labwc/autostart
ORIG=$SYS.orig
USER_AUTOSTART=${XDG_CONFIG_HOME:-$HOME/.config}/labwc/autostart
SAVED=$USER_AUTOSTART.kiosk
BEGIN='# >>> webscreensaver kiosk (setup-kiosk) >>>'
END='# <<< webscreensaver kiosk <<<'

case $1 in
	on)
		if [ -f "$SAVED" ]; then
			cat "$SAVED" >> "$USER_AUTOSTART"
			rm "$SAVED"
		fi
		if ! grep -qsF "$BEGIN" "$USER_AUTOSTART"; then
			echo "No kiosk in $USER_AUTOSTART; run setup-kiosk first." >&2
			exit 1
		fi
		[ -f "$ORIG" ] || sudo cp -p "$SYS" "$ORIG"
		sudo tee "$SYS" >/dev/null <<-EOF
		# Kiosk: desktop, panel and XDG autostart disabled to save memory.
		# Original in autostart.orig; switch back with kiosk-mode off.
		/usr/bin/kanshi &
		EOF
		echo "Kiosk mode on; reboot to apply."
		;;
	off)
		[ -f "$ORIG" ] && sudo cp -p "$ORIG" "$SYS"
		if grep -qsF "$BEGIN" "$USER_AUTOSTART"; then
			sed -n "/^$BEGIN\$/,/^$END\$/p" "$USER_AUTOSTART" > "$SAVED"
			sed -i "/^$BEGIN\$/,/^$END\$/d" "$USER_AUTOSTART"
		fi
		echo "Desktop mode on; reboot to apply. The kiosk will not start (kiosk-mode on brings it back)."
		;;
	status)
		if [ -f "$ORIG" ] && ! cmp -s "$ORIG" "$SYS"; then
			echo "kiosk"
		else
			echo "desktop"
		fi
		;;
	*)
		echo "usage: kiosk-mode on|off|status" >&2
		exit 1
		;;
esac
