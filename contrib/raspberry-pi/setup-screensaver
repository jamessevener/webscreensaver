#!/bin/bash
#
# Set up webscreensaver as the idle screensaver on Raspberry Pi OS (labwc),
# started by swayidle. Run it as the desktop user (it uses sudo), then log
# out and back in or reboot. Meant for a Pi 4/5; a Pi Zero is too slow to
# start a page quickly when the screen goes idle.
#
# Usage: setup-screensaver [options] [webscreensaver args...]
#
#   --timeout SECS      idle time before it starts (default 300)
#   --lock              lock with swaylock when the screensaver is dismissed
#   --lock-after SECS   with --lock, only lock if it ran at least SECS seconds
#   --no-dmabuf         render WebKit without DMA-BUF, for when the page shows
#                       as garbled stripes (seen on a Pi 4 with a rotated screen)
#   --remove            remove the screensaver from the autostart
#
# The webscreensaver args pick the page (default -cycle); -fullscreen is
# always added. It also installs wifi-keepalive, which reconnects Wi-Fi if
# NetworkManager gets stuck waiting on a password dialog. Examples:
#   setup-screensaver
#   setup-screensaver --timeout 600 --lock -choose flyingtoasters
#   setup-screensaver --timeout 600 --no-dmabuf -url https://dashboard.example.com
#   setup-screensaver -sites-list ~/sites.toml -cycle

set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
repo=$(readlink -f "$here/../..")
bin=$HOME/.local/bin
autostart=${XDG_CONFIG_HOME:-$HOME/.config}/labwc/autostart
begin='# >>> webscreensaver (setup-screensaver) >>>'
end='# <<< webscreensaver <<<'

timeout=300
lock=
lock_after=
no_dmabuf=
remove=
args=()
while (($#)); do
	case $1 in
		--timeout) timeout=$2; shift ;;
		--lock) lock=1 ;;
		--lock-after) lock_after=$2; shift ;;
		--no-dmabuf) no_dmabuf=1 ;;
		--remove) remove=1 ;;
		--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
		*) args+=("$1") ;;
	esac
	shift
done
((${#args[@]})) || args=(-cycle)

# Drop any block written by an earlier run.
mkdir -p "$(dirname "$autostart")"
touch "$autostart"
sed -i "/^$begin\$/,/^$end\$/d" "$autostart"

if [[ $remove ]]; then
	echo "Removed from $autostart; takes effect at next login."
	exit 0
fi

echo "== Packages"
packages=(python3 python3-gi gir1.2-gtk-3.0 gir1.2-webkit2-4.1 gir1.2-gtklayershell-0.1 swayidle)
[[ $lock ]] && packages+=(swaylock)
sudo apt-get install -y "${packages[@]}"

echo "== Script in $bin"
mkdir -p "$bin"
install -m 755 "$repo/webscreensaver" "$bin/"

echo "== Wi-Fi"
# Reconnect when NetworkManager is stuck waiting on a password dialog.
"$here/wifi-keepalive" install

cmd=("$bin/webscreensaver" -fullscreen)
[[ $no_dmabuf ]] && cmd=(env WEBKIT_DISABLE_DMABUF_RENDERER=1 "${cmd[@]}")
if [[ $lock ]]; then
	cmd+=(-lock-command 'swaylock -f')
	[[ $lock_after ]] && cmd+=(-lock-after "$lock_after")
fi
cmd+=("${args[@]}")

# swayidle runs the command with sh -c, so it is quoted once for that and
# again for the autostart's own shell. No resume command: webscreensaver
# exits by itself on input (and a "pkill -f webscreensaver" would also match
# swayidle's own command line).
inner=$(printf '%q ' "${cmd[@]}")
inner=${inner% }
inner="'${inner//\'/\'\\\'\'}'"
cat >> "$autostart" <<EOF
$begin
swayidle timeout $(printf '%q' "$timeout") $inner &
$end
EOF

echo "== Autostart in $autostart"
cat "$autostart"
echo "Log out and back in (or reboot) to start it."
